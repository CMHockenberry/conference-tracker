# Copy this file to .env and fill in real values before running in production.

# Port the app listens on
PORT=3000

# Set to "production" once you're running behind HTTPS (nginx + certbot).
# This makes login cookies "secure" (HTTPS-only). Leave unset for local testing over http://localhost.
NODE_ENV=production

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# These three only matter on the very first run, when the database is empty.
# The app creates one admin account from these values so you have a way to log in.
# Change this password immediately after your first login (or just set a strong
# one here before you ever start the server).
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
